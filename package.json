{
  "name": "obsidian-xingce",
  "version": "0.1.0",
  "description": "在 Obsidian 里刷行测真题：随机抽题、考点专项、整卷模考、错题本。",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "verify": "node scripts/verify-parse.mjs",
    "test": "node scripts/test-bank.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:all": "node scripts/test-bank.mjs && node scripts/test-ui.mjs",
    "import": "node scripts/import.mjs",
    "shoot": "node scripts/shoot.mjs examples/示例题库 screenshots xingce-practice-view practice.png",
    "shoot:exam": "node scripts/shoot.mjs examples/示例题库 screenshots xingce-exam-view exam.png"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "xingce",
    "行测",
    "公务员",
    "刷题"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "builtin-modules": "5.0.0",
    "esbuild": "0.24.2",
    "jsdom": "^30.1.3",
    "obsidian": "latest",
    "tslib": "2.8.1",
    "typescript": "5.7.2"
  }
}
